# Copy this file to terraform.tfvars and fill in values.

region                  = "us-west-2"
environment             = "dev"

# Backend (ahtr-app) CodePipeline
repository_id           = "nivanmorgan/ahtr-app"
branch                  = "main"
code_connection_arn     = "arn:aws:codeconnections:us-west-2:<ACCOUNT_ID>:connection/<CONNECTION_ID>"

# Frontend (ahtr-ui) CodePipeline
frontend_repository_id       = "nivanmorgan/ahtr-ui"
frontend_branch              = "main"
frontend_code_connection_arn = "arn:aws:codeconnections:us-west-2:<ACCOUNT_ID>:connection/<CONNECTION_ID>"

# Names must be globally unique
artifact_bucket_name    = "ahtr-dev-artifacts-CHANGE_ME_UNIQUE"
images_bucket_name      = "ahtr-dev-images-CHANGE_ME_UNIQUE"
frontend_bucket_name    = "ahtr-dev-frontend-CHANGE_ME_UNIQUE"

# Database (use temporary creds for dev; rotate later)
db_name     = "ahtr"
db_user     = "ahtr_user"
db_password = "CHANGE_ME_STRONG_PASSWORD"

# Optional HTTPS + DNS (comment out if not used)
# certificate_arn = "arn:aws:acm:us-west-2:<ACCOUNT_ID>:certificate/<CERT_ID>"
# domain_name     = "api.dev.example.com"
# hosted_zone_id  = "ZXXXXXXXXXXXXX"

# Optional: specify non-default VPC/subnets
# vpc_id     = "vpc-xxxxxxxx"
# subnet_ids = ["subnet-aaaa", "subnet-bbbb", "subnet-cccc"]
